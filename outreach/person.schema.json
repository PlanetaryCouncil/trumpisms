{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trumpisms.planetarycouncil.org/outreach/person.schema.json",
  "title": "Person",
  "description": "One billionaire record. One JSON object per line in people.jsonl. Every sensitive or judgement-based field carries provenance (source + as_of). Contact PII is null until sourced legitimately — never guessed.",
  "type": "object",
  "required": ["id", "name", "climate", "meta", "outreach"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug key, lowercase, ascii. The dedup + merge target. Never reused, never changed once set.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "aka": {
      "type": "array",
      "description": "Alternate spellings / transliterations, to catch duplicates on import.",
      "items": { "type": "string" }
    },

    "contacts": {
      "type": "object",
      "description": "PII. Seed as null with a needs_research status — do not guess emails or personal handles.",
      "additionalProperties": false,
      "properties": {
        "email":   { "type": ["array", "null"], "items": { "$ref": "#/$defs/sourcedString" } },
        "fb":      { "type": ["string", "null"], "description": "Personal Facebook URL, if public." },
        "insta":   { "type": ["string", "null"], "description": "Personal Instagram handle/URL, if public." },
        "linkedin":{ "type": ["string", "null"] },
        "x":       { "type": ["string", "null"], "description": "X / Twitter handle." },
        "other":   { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },

    "companies": {
      "type": "array",
      "description": "Embedded, not normalized: at 3k people, company dedup does not pay for the join. Each carries the person's role and the company's own public channels.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string" },
          "role":   { "type": "string", "description": "founder | ceo | chair | owner | investor | heir …" },
          "url":    { "type": ["string", "null"] },
          "socials":{ "type": "array", "items": { "$ref": "#/$defs/link" } },
          "primary":{ "type": "boolean", "description": "The company the fortune is chiefly from." }
        }
      }
    },

    "climate": {
      "type": "object",
      "description": "0–10 climate orientation. A JUDGEMENT, so it must carry rationale + sources. 0 = actively obstructive; 5 = neutral/absent; 10 = fortune actively deployed against the crisis.",
      "required": ["score"],
      "additionalProperties": false,
      "properties": {
        "score":      { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "rationale":  { "type": "string", "description": "One or two sentences. What the score is based on." },
        "sources":    { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "as_of":      { "type": "string", "format": "date" }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net_worth_usd_b": { "type": ["number", "null"], "description": "Approx net worth in US$ billions. Bracket is fine; cite the list." },
        "source_of_wealth":{ "type": ["string", "null"] },
        "country":         { "type": ["string", "null"], "description": "ISO or plain country name." },
        "born":            { "type": ["integer", "null"] },
        "gender":          { "type": ["string", "null"] },
        "source":          { "$ref": "#/$defs/link", "description": "The wealth-list citation (Forbes/Bloomberg + year)." }
      }
    },

    "outreach": {
      "type": "object",
      "description": "The CRM layer — what makes the personalised approach possible.",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["needs_research", "researched", "queued", "contacted", "responded", "meeting", "signed", "declined", "do_not_contact"]
        },
        "angle":       { "type": ["string", "null"], "description": "The specific hook for THIS person: a stated position, a foundation, a public regret, a rivalry. Drives the draft." },
        "owner":       { "type": ["string", "null"], "description": "Who on the team owns this relationship." },
        "channel":     { "type": ["string", "null"], "description": "Best route in: warm intro via X, foundation program officer, etc." },
        "last_contact":{ "type": ["string", "null"], "format": "date" },
        "notes":       { "type": "array", "items": { "type": "string" } },
        "do_not_contact_reason": { "type": ["string", "null"] }
      }
    },

    "updated": { "type": "string", "format": "date", "description": "Last edit to this record." }
  },

  "$defs": {
    "link": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "url":   { "type": "string" }
      }
    },
    "sourcedString": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value":  { "type": "string" },
        "source": { "type": "string", "description": "How this was obtained — never a guess." },
        "as_of":  { "type": "string", "format": "date" }
      }
    }
  }
}
